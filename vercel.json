{
"version": 2,
"builds": [
{
"src": "public//*",
"use": "@vercel/static-build",
"config": {
"distDir": "public"
}
},
{
"src": "netlify/functions/server.js",
"use": "@vercel/node",
"config": {
"includeFiles": "public//"
}
}
],
"routes": [
{
"src": "/api/(.)",
"dest": ".netlify/functions/server.js"
},
{
"src": "/(.*)",
"dest": "/public/$1"
}
]
}